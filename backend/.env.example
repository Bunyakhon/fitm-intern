# ==========================================
# Application
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# PostgreSQL
# ==========================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=intern_system
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# ==========================================
# JWT
# สร้างด้วย: openssl rand -hex 64
# ==========================================
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1d

# Google Identity Services: enable only after migration and policy approval.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_ACCOUNT_LINKING_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_EMAIL_DOMAINS=kmutnb.ac.th,email.kmutnb.ac.th
# required verifies Workspace ownership; hd need not equal the email domain.
GOOGLE_HOSTED_DOMAIN_POLICY=required
GOOGLE_ALLOWED_HOSTED_DOMAINS=kmutnb.ac.th
# Optional role overrides (must also belong to the global email allowlist):
# GOOGLE_ALLOWED_EMAIL_DOMAINS_STUDENT=email.kmutnb.ac.th
# GOOGLE_ALLOWED_EMAIL_DOMAINS_TEACHER=kmutnb.ac.th
# GOOGLE_ALLOWED_EMAIL_DOMAINS_DEPARTMENT_HEAD=kmutnb.ac.th
# GOOGLE_ALLOWED_EMAIL_DOMAINS_DEPARTMENT_STAFF=kmutnb.ac.th

# ==========================================
# Frontend
# เปลี่ยนเป็น IP/Domain ของ Server
# ==========================================
FRONTEND_URL=http://SERVER_IP:5173

# ==========================================
# NLP Service
# ==========================================
NLP_SERVICE_BASE_URL=http://nlp-service:8000
NLP_SERVICE_TIMEOUT_MS=5000
NLP_OCR_TIMEOUT_MS=20000

# ==========================================
# Recruitment
# ปิดไว้จนกว่าจะตั้ง SMTP + Turnstile
# ==========================================
RECRUITMENT_SUBMISSION_ENABLED=false

# ==========================================
# SMTP - Optional
# ==========================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=FITM Internship System

# ==========================================
# Cloudflare Turnstile - Optional
# ==========================================
# TURNSTILE_SECRET_KEY=
# TURNSTILE_EXPECTED_HOSTNAME=
# TURNSTILE_EXPECTED_ACTION=
