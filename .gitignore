# ===== Environment variables =====
.env
.env.local
backend/.env
frontend/.env
nlp-service/.env

# ===== Node.js (backend / frontend) =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ===== Python (nlp-service) =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ===== NLP-service data (ไฟล์ใหญ่ / อาจมี PII) =====
# raw, models, embeddings: ignore ทั้งหมด เก็บแค่ .gitkeep ไว้ให้ git track โฟลเดอร์
nlp-service/data/raw/*
!nlp-service/data/raw/.gitkeep

nlp-service/data/models/*
!nlp-service/data/models/.gitkeep
!nlp-service/data/models/matching/
nlp-service/data/models/matching/*
!nlp-service/data/models/matching/.gitkeep
!nlp-service/data/models/chatbot/
nlp-service/data/models/chatbot/*
!nlp-service/data/models/chatbot/.gitkeep

nlp-service/data/embeddings/*
!nlp-service/data/embeddings/.gitkeep

# processed: ignore หมดยกเว้น faq_seed.json (ชุดข้อมูลเทรน chatbot ที่เป็นซอร์สโค้ด ไม่ใช่ข้อมูลนักศึกษาจริง)
nlp-service/data/processed/*
!nlp-service/data/processed/.gitkeep
!nlp-service/data/processed/chatbot/
nlp-service/data/processed/chatbot/*
!nlp-service/data/processed/chatbot/faq_seed.json

# ===== Docker =====
# (ไม่ต้อง ignore docker-compose.yml เพราะต้อง commit ไฟล์นี้)

# ===== IDE / Editor =====
.vscode/
.idea/
*.swp

# ===== OS =====
.DS_Store
Thumbs.db

# ===== Logs =====
logs/
*.log

# ===== Build output =====
dist/
build/
frontend/dist/

# Disposable Vite output; keep adjacent audit results and security evidence.
/docs/audits/evidence/google-oauth-hd-diagnostic/build-check/

# Regenerated pytest cache; tests and fixtures remain versioned.
/nlp-service/.pytest_cache/

# ===== Secrets / Keys =====
*.pem
*.key
*.crt

# Local Development account credentials: Windows DPAPI, private ACL; never publish.
/.local-dev-accounts/
